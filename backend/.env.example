# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database Connection URL (AWS ap-south-1 Pooler)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Database Pool & SSL Configuration
DB_SSL=true
DB_POOL_MAX=15
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d

# Allowed CORS origin in production (Vercel deployment URL)
FRONTEND_URL=https://indian-railways-ten.vercel.app
